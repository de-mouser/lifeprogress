# Environment variables for GATE Tracker
# Copy this file to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Owner Secret (hashed bcrypt hash of "UNDER100RANK")
# Generate with: node -e "const b=require('bcryptjs');b.hash('UNDER100RANK',12).then(h=>console.log(h))"
# Paste the generated hash here:
OWNER_SECRET_HASH=$2b$12$REPLACE_WITH_YOUR_BCRYPT_HASH

# Session Secret (32+ random chars, generate with: openssl rand -base64 32)
SESSION_SECRET=replace_with_a_very_long_random_secret_string_at_least_32_chars

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
TIMEZONE=Asia/Kolkata
